<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mir100_ref">
  <xacro:include filename="$(find mir_description)/urdf/include/common_properties.urdf.xacro" />

  <xacro:property name="deg_to_rad" value="0.017453293" />

  <xacro:property name="mir_100_base_mass" value="58.0" />

  <xacro:property name="mir_100_act_wheel_radius" value="0.0625" />
  <xacro:property name="mir_100_act_wheel_width" value="0.032" />
  <xacro:property name="mir_100_act_wheel_mass" value="1.0" />
  <xacro:property name="mir_100_act_wheel_dx" value="0.037646" />
  <xacro:property name="mir_100_act_wheel_dy" value="0.222604" />

  <xacro:property name="mir_100_caster_wheel_radius" value="${mir_100_act_wheel_radius}" />
  <xacro:property name="mir_100_caster_wheel_width" value="${mir_100_act_wheel_width}" />
  <xacro:property name="mir_100_caster_wheel_mass" value="${mir_100_act_wheel_mass}" />
  <xacro:property name="mir_100_caster_wheel_dx" value="-0.0382" />
  <xacro:property name="mir_100_caster_wheel_dy" value="0" />
  <xacro:property name="mir_100_caster_wheel_dz" value="-0.094" />
  <xacro:property name="mir_100_front_caster_wheel_base_dx" value="0.341346" />
  <xacro:property name="mir_100_back_caster_wheel_base_dx" value="-0.270154" />
  <xacro:property name="mir_100_caster_wheel_base_dy" value="0.203" />
  <xacro:property name="mir_100_caster_wheel_base_dz" value="${mir_100_caster_wheel_radius-mir_100_caster_wheel_dz}" />

  <xacro:macro name="actuated_wheel" params="prefix locationprefix locationright">
    <joint name="${prefix}${locationprefix}_wheel_joint" type="continuous">
      <origin xyz="0.0 ${-mir_100_act_wheel_dy * locationright} ${mir_100_act_wheel_radius}" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}${locationprefix}_wheel_link" />
      <axis xyz="0 1 0" />
      <limit effort="100" velocity="20.0" />
    </joint>

    <link name="${prefix}${locationprefix}_wheel_link">
      <xacro:cylinder_inertial mass="${mir_100_act_wheel_mass}" radius="${mir_100_act_wheel_radius}" length="${mir_100_act_wheel_width}">
        <origin xyz="0 0 0" rpy="${0.5 * pi} 0 0" />
      </xacro:cylinder_inertial>
      <visual>
        <geometry>
          <mesh filename="package://mir_description/meshes/visual/wheel.stl" />
        </geometry>
        <xacro:insert_block name="material_dark_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${0.5 * pi} 0 0" />
        <geometry>
          <cylinder radius="${mir_100_act_wheel_radius}" length="${mir_100_act_wheel_width}" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="caster_wheel" params="prefix locationprefix locationright wheel_base_dx">
    <joint name="${prefix}${locationprefix}_caster_rotation_joint" type="continuous">
      <origin xyz="${wheel_base_dx} ${-mir_100_caster_wheel_base_dy * locationright} ${mir_100_caster_wheel_base_dz}" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}${locationprefix}_caster_rotation_link" />
      <axis xyz="0 0 1" />
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <link name="${prefix}${locationprefix}_caster_rotation_link">
      <inertial>
        <origin xyz="0 0 -0.042500000044" rpy="${24 * deg_to_rad} 0 ${0.5 * pi}" />
        <mass value="0.3097539019" />
        <inertia ixx="0.0005844517978" ixy="0" ixz="0" iyy="0.00052872551237" iyz="0" izz="0.00017923555074" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://mir_description/meshes/visual/caster_wheel_base.stl" />
        </geometry>
        <xacro:insert_block name="material_silver" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.04" length="0.08" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}${locationprefix}_caster_wheel_joint" type="continuous">
      <origin xyz="${mir_100_caster_wheel_dx} ${-mir_100_caster_wheel_dy * locationright} ${mir_100_caster_wheel_dz}" rpy="0 0 0" />
      <parent link="${prefix}${locationprefix}_caster_rotation_link" />
      <child link="${prefix}${locationprefix}_caster_wheel_link" />
      <axis xyz="0 1 0" />
    </joint>

    <link name="${prefix}${locationprefix}_caster_wheel_link">
      <xacro:cylinder_inertial mass="${mir_100_caster_wheel_mass}" radius="${mir_100_caster_wheel_radius}" length="${mir_100_caster_wheel_width}">
        <origin xyz="0 0 0" rpy="${0.5 * pi} 0 0" />
      </xacro:cylinder_inertial>
      <visual>
        <geometry>
          <mesh filename="package://mir_description/meshes/visual/wheel.stl" />
        </geometry>
        <xacro:insert_block name="material_dark_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${0.5 * pi} 0 0" />
        <geometry>
          <cylinder radius="${mir_100_caster_wheel_radius}" length="${mir_100_caster_wheel_width}" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <link name="base_footprint" />

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <xacro:box_inertial mass="${mir_100_base_mass}" x="0.9" y="0.58" z="0.3">
      <origin xyz="${mir_100_act_wheel_dx} 0 0.20" rpy="0 0 0" />
    </xacro:box_inertial>
    <!-- REF-MATCHED derivative: stock accurate MiR100 shell (mir_100_base.stl, DFKI mesh already in repo,
         BSD license, meters, same origin convention) replaces user's custom shell as the VISUAL.
         Collision/inertial/joints/TF unchanged from tested custom model. Added: cyan light band as 4 thin bars
         BELOW the scanner plane (z 0.168-0.182 < scanner z 0.191) stopping short of all corners - cosmetic,
         avoids laser self-hits by construction. No logo texture. -->
    <visual>
      <origin xyz="${mir_100_act_wheel_dx} 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mir_description/meshes/visual/mir_100_base.stl" />
      </geometry>
      <material name="mirref_shell_white"><color rgba="0.93 0.94 0.96 1"/></material>
    </visual>
    <visual>
      <origin xyz="${mir_100_act_wheel_dx} 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mir_description/meshes/visual/mirref/band.stl" />
      </geometry>
      <material name="mirref_band_cyan"><color rgba="0.0 0.75 0.95 1.0" /></material>
    </visual>
    <collision>
      <!-- Keep the chassis off the floor; only wheels should make ground contact. -->
      <origin xyz="${mir_100_act_wheel_dx} 0 0.20" rpy="0 0 0" />
      <geometry>
        <box size="0.9 0.58 0.25" />
      </geometry>
    </collision>
  </link>

  <joint name="base_link_to_imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0.0 0.0 0.25" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />

  <joint name="imu_link_to_imu_frame_joint" type="fixed">
    <parent link="imu_link" />
    <child link="imu_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="imu_frame" />

  <joint name="base_link_to_front_laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_laser_link" />
    <origin xyz="0.4288 0.2358 0.1914" rpy="0.0 0.0 ${0.25 * pi}" />
  </joint>
  <link name="front_laser_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="${pi} 0 0" />
      <geometry>
        <mesh filename="package://mir_description/meshes/visual/sick_lms-100.stl" />
      </geometry>
      <xacro:insert_block name="material_black" />
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <box size="0.16 0.16 0.08" />
      </geometry>
    </collision>
    <xacro:box_inertial x="0.156" y="0.155" z="0.185" mass="2.0">
      <origin xyz="0 0 0" />
    </xacro:box_inertial>
  </link>
  <gazebo reference="front_laser_link">
    <sensor name="front_scan" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>12.5</update_rate>
      <topic>scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>541</samples>
            <resolution>1</resolution>
            <!-- Custom shell enters the fan edge: mask the inner 5 degrees (real MiR100 installs mask body-adjacent rays the same way) -->
            <min_angle>-2.2689289</min_angle>
            <max_angle>2.35619449615</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>29.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <joint name="base_link_to_back_laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="back_laser_link" />
    <origin xyz="-0.3548 -0.2352 0.1914" rpy="0.0 0.0 ${-0.75 * pi}" />
  </joint>
  <link name="back_laser_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="${pi} 0 0" />
      <geometry>
        <mesh filename="package://mir_description/meshes/visual/sick_lms-100.stl" />
      </geometry>
      <xacro:insert_block name="material_black" />
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <box size="0.16 0.16 0.08" />
      </geometry>
    </collision>
    <xacro:box_inertial x="0.156" y="0.155" z="0.185" mass="2.0">
      <origin xyz="0 0 0" />
    </xacro:box_inertial>
  </link>
  <gazebo reference="back_laser_link">
    <sensor name="back_scan" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>12.5</update_rate>
      <topic>back_scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>541</samples>
            <resolution>1</resolution>
            <!-- Custom shell enters the fan edge: mask the inner 5 degrees (real MiR100 installs mask body-adjacent rays the same way) -->
            <min_angle>-2.2689289</min_angle>
            <max_angle>2.35619449615</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>29.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <xacro:actuated_wheel prefix="" locationprefix="left" locationright="-1" />
  <xacro:actuated_wheel prefix="" locationprefix="right" locationright="1" />
  <xacro:caster_wheel prefix="" locationprefix="fl" locationright="-1" wheel_base_dx="${mir_100_front_caster_wheel_base_dx}" />
  <xacro:caster_wheel prefix="" locationprefix="fr" locationright="1" wheel_base_dx="${mir_100_front_caster_wheel_base_dx}" />
  <xacro:caster_wheel prefix="" locationprefix="bl" locationright="-1" wheel_base_dx="${mir_100_back_caster_wheel_base_dx}" />
  <xacro:caster_wheel prefix="" locationprefix="br" locationright="1" wheel_base_dx="${mir_100_back_caster_wheel_base_dx}" />

  <joint name="base_link_surface_joint" type="fixed">
    <origin xyz="${mir_100_act_wheel_dx} 0 0.352" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="surface" />
  </joint>
  <link name="surface" />

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1.0</static_update_frequency>
    </plugin>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2 * mir_100_act_wheel_dy}</wheel_separation>
      <wheel_radius>${mir_100_act_wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
    </plugin>
  </gazebo>

  <link name="mirref_top_holes">
    <visual><geometry><mesh filename="package://mir_description/meshes/visual/mirref/top_holes.stl"/></geometry>
      <material name="mirref_dark"><color rgba="0.12 0.12 0.14 1"/></material></visual>
  </link>
  <joint name="mirref_top_holes_joint" type="fixed"><parent link="base_link"/><child link="mirref_top_holes"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="mirref_front_ports">
    <visual><geometry><mesh filename="package://mir_description/meshes/visual/mirref/front_details.stl"/></geometry>
      <material name="mirref_dark2"><color rgba="0.10 0.10 0.12 1"/></material></visual>
  </link>
  <joint name="mirref_front_ports_joint" type="fixed"><parent link="base_link"/><child link="mirref_front_ports"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="mirref_corner_caps">
    <visual><geometry><mesh filename="package://mir_description/meshes/visual/mirref/corner_caps.stl"/></geometry>
      <material name="mirref_dark3"><color rgba="0.12 0.12 0.14 1"/></material></visual>
  </link>
  <joint name="mirref_corner_caps_joint" type="fixed"><parent link="base_link"/><child link="mirref_corner_caps"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  
</robot>
