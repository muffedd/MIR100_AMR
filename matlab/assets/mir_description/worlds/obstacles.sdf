<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="obstacles">
    <physics name="realtime_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <!-- Use Gazebo's standard GUI configuration.  The default config includes
         the full MinimalScene / scene-manager setup needed for rendering. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Enclose the obstacle course so 2D SLAM can observe a bounded room. -->
    <model name="north_wall">
      <static>true</static><pose>4 4 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual></link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>4 -4 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual></link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-2 0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 8 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8 1</size></box></geometry></visual></link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>10 0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 8 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8 1</size></box></geometry></visual></link>
    </model>
    <model name="box_1">
      <static>true</static>
      <pose>2.2 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.7 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>4.0 1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.7 1</ambient>
            <diffuse>0.2 0.3 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>4.0 -1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.7 0.3 1</ambient>
            <diffuse>0.2 0.7 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Extra furniture blocks make the practice course moderately challenging
         while leaving broad routes around each obstacle. -->
    <model name="box_4">
      <static>true</static>
      <pose>0.0 1.9 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.7 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 0.7 0.9</size></box></geometry><material><ambient>0.65 0.45 0.2 1</ambient><diffuse>0.65 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_5">
      <static>true</static>
      <pose>0.2 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.9 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.9 1.0</size></box></geometry><material><ambient>0.2 0.55 0.6 1</ambient><diffuse>0.2 0.55 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_6">
      <static>true</static>
      <pose>6.5 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.8 1.0</size></box></geometry><material><ambient>0.65 0.3 0.55 1</ambient><diffuse>0.65 0.3 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_7">
      <static>true</static>
      <pose>6.7 -2.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.8 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.8 0.9</size></box></geometry><material><ambient>0.7 0.55 0.15 1</ambient><diffuse>0.7 0.55 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_8">
      <static>true</static>
      <pose>8.4 0.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.8</size></box></geometry><material><ambient>0.3 0.55 0.25 1</ambient><diffuse>0.3 0.55 0.25 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
